# BIG COMMIT TO BATCH  
# where d is the root folder, while commit each subfolder as batches
for dir in d/*/; do
    git add "$dir"
    git diff --cached --quiet && continue   # nothing staged (all ignored) → skip
    git commit -q -m "vault batch $dir"
    git push origin master || break         # stop on first rejected push
done


# Ignore local deletions to not mess upstream
git ls-files -z --deleted | git update-index --skip-worktree -z --stdin
