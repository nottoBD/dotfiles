#!/usr/bin/env bash
#
# Script name: dm-logout
# Description: Logout, shutdown, reboot, lock screen, or schedule a timed
#              suspend/shutdown.
# Dependencies: dmenu, fzf, rofi, systemd, slock, notify-send
# GitLab: https://www.gitlab.com/dwt1/dmscripts
# License: https://www.gitlab.com/dwt1/dmscripts/LICENSE
# Contributors: Derek Taylor,
#               Simon Ingelsson

# Set with the flags "-e", "-u","-o pipefail" cause the script to fail
# if certain things happen, which is a good thing.  Otherwise, we can
# get hidden bugs that are hard to discover.
set -euo pipefail
export XDG_SESSION_TYPE=x11
# shellcheck disable=SC1091
source ./_dm-helper.sh 2>/dev/null || source _dm-helper.sh 2>/dev/null

source_dmscripts_configs

if configs_are_different; then
	echo "$(date): configs are different" >>"$DM_CONFIG_DIFF_LOGFILE"
	sleep 1
fi

# use notify-send if run in dumb term
# TODO: add abillity to control from config.
_out="echo"
if [[ ${TERM} == 'dumb' ]]; then
	_out="notify-send"
fi

output() {
	${_out} "dm-logout" "$@"
}

# ---------------------------------------------------------------------------
# Timer state
#
# A pending timer is a detached subshell sleeping until its deadline.  Two
# small files let a later invocation of the script report on it or kill it:
#   .pid   -> pid of the sleeping subshell
#   .info  -> "<action>\t<deadline as unix epoch>"
# ---------------------------------------------------------------------------
if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
	_timer_base="${XDG_RUNTIME_DIR}/dm-logout.timer"
else
	_timer_base="/tmp/dm-logout-${UID}.timer"
fi
readonly TIMER_PIDFILE="${_timer_base}.pid"
readonly TIMER_INFOFILE="${_timer_base}.info"

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a "dm-logout" "$1" "$2"
	else
		printf '%s: %s\n' "$1" "$2"
	fi
}

# Single point of truth for the power commands.  Swap these lines if you are
# not on systemd (e.g. "loginctl suspend" / "loginctl poweroff").
run_action() {
	case $1 in
	suspend) systemctl suspend ;;
	shutdown) systemctl poweroff ;;
	reboot) systemctl reboot ;;
	*) return 1 ;;
	esac
}

action_label() {
	case $1 in
	suspend) printf 'Suspend' ;;
	shutdown) printf 'Shutdown' ;;
	reboot) printf 'Reboot' ;;
	*) printf 'Unknown' ;;
	esac
}

# shellcheck disable=SC2086
confirm() {
	[[ "$(printf 'No\nYes\n' | ${MENU} "$1")" == "Yes" ]]
}

timer_pid() {
	if [[ -s ${TIMER_PIDFILE} ]]; then
		cat "${TIMER_PIDFILE}"
	else
		return 1
	fi
}

timer_running() {
	local pid
	pid=$(timer_pid) || return 1
	[[ -n ${pid} ]] || return 1
	kill -0 "${pid}" 2>/dev/null
}

timer_action() { cut -f1 "${TIMER_INFOFILE}" 2>/dev/null; }
timer_deadline() { cut -f2 "${TIMER_INFOFILE}" 2>/dev/null; }

fmt_remaining() {
	local secs=$1
	if ((secs < 0)); then
		secs=0
	fi
	if ((secs >= 3600)); then
		printf '%dh%02dm' $((secs / 3600)) $(((secs % 3600) / 60))
	elif ((secs >= 60)); then
		printf '%dm%02ds' $((secs / 60)) $((secs % 60))
	else
		printf '%ds' "${secs}"
	fi
}

kill_timer() {
	local quiet=${1:-} pid label
	if timer_running; then
		label=$(action_label "$(timer_action)")
		pid=$(timer_pid)
		# Kill the sleep first, then the subshell holding it.
		pkill -P "${pid}" 2>/dev/null || true
		kill "${pid}" 2>/dev/null || true
	else
		label="Timer"
	fi
	rm -f "${TIMER_PIDFILE}" "${TIMER_INFOFILE}"
	if [[ ${quiet} != "quiet" ]]; then
		notify "dm-logout" "${label} timer killed."
	fi
}

start_timer() {
	local action=$1 minutes=$2
	local seconds=$((minutes * 60))
	local label deadline
	label=$(action_label "${action}")
	deadline=$(($(date +%s) + seconds))

	(
		trap '' HUP
		if ((seconds > 60)); then
			sleep $((seconds - 60))
			notify "dm-logout" "${label} in 1 minute."
			sleep 60
		else
			sleep "${seconds}"
		fi
		rm -f "${TIMER_PIDFILE}" "${TIMER_INFOFILE}"
		run_action "${action}"
	) >/dev/null 2>&1 &

	printf '%s\n' "$!" >"${TIMER_PIDFILE}"
	printf '%s\t%s\n' "${action}" "${deadline}" >"${TIMER_INFOFILE}"
	disown 2>/dev/null || true

	notify "dm-logout" "${label} at $(date -d "@${deadline}" '+%H:%M') (in ${minutes} min)."
}

# Free-text prompt: the menu is fed an empty list, so whatever you type is
# what comes back.  Anything that is not a sane integer aborts.
# shellcheck disable=SC2086
ask_minutes() {
	local input
	if ! input=$(printf '' | ${MENU} "$1 in how many minutes?"); then
		return 1
	fi
	input=${input//[[:space:]]/}
	if [[ ! ${input} =~ ^[0-9]+$ ]]; then
		return 1
	fi
	if ((input < 1 || input > 1440)); then
		return 1
	fi
	printf '%s' "${input}"
}

# Timer submenu: pick the action, type the minutes, done.  No confirmation.
# shellcheck disable=SC2086
timer_menu() {
	local pick action minutes
	pick=$(printf '%s\n' "Suspend" "Shutdown" | ${MENU} 'Timer:') || exit 0
	case ${pick} in
	'Suspend') action="suspend" ;;
	'Shutdown') action="shutdown" ;;
	*) exit 0 ;;
	esac

	if ! minutes=$(ask_minutes "$(action_label "${action}")"); then
		output "No timer set."
		exit 0
	fi
	if timer_running; then
		kill_timer quiet
	fi
	start_timer "${action}" "${minutes}"
}

main() {
	# An array of options to choose.
	declare -a options=(
		"Lock screen"
		"Timer"
		"Logout"
		"Reboot"
		"Suspend"
		"Shutdown"
	)

	# The kill entry only exists while something is actually scheduled.
	if timer_running; then
		options+=("Kill timer ($(action_label "$(timer_action)") in $(fmt_remaining $(($(timer_deadline) - $(date +%s)))))")
	fi

	# look up what managers are used (makes it more dynamic)
	declare -a managers
	while IFS= read -r manager; do
		managers+=("${manager,,}")
	done < <(grep-desktop)
	# Original code, used as a refrence and as backup
	# done < <(grep 'Name=' /usr/share/xsessions/*.desktop | cut -d'=' -f2)
	managers+=("xmonad-x86_64-linux")
	# Piping the above array into dmenu, fzf or rofi.
	# We use "printf '%s\n'" to format the array one item to a line.
	choice=$(printf '%s\n' "${options[@]}" | ${MENU} 'Shutdown menu:')

	# What to do when/if we choose one of the options.
	case $choice in
	'Lock screen')
		# shellcheck disable=SC2154
		${logout_locker}
		;;
	'Timer')
		timer_menu
		;;
	'Logout')
		if confirm "${choice}?"; then
			for manager in "${managers[@]}"; do
				loginctl kill-user "$UID"
				pkill X
			done
		else
			output "User chose not to logout." && exit 1
		fi
		;;
	'Reboot')
		if confirm "${choice}?"; then
			run_action reboot
		else
			output "User chose not to reboot." && exit 0
		fi
		;;
	'Suspend')
		if confirm "${choice}?"; then
			run_action suspend
		else
			output "User chose not to suspend." && exit 0
		fi
		;;
	'Shutdown')
		if confirm "${choice}?"; then
			run_action shutdown
		else
			output "User chose not to shutdown." && exit 0
		fi
		;;
	'Kill timer'*)
		kill_timer
		;;
	# It is a common practice to use the wildcard asterisk symbol (*) as a final
	# pattern to define the default case. This pattern will always match.
	*)
		exit 0
		;;
	esac

}

MENU="$(get_menu_program "$@")"
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && main
